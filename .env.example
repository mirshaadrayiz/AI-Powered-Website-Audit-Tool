# Google Gemini API key — free, no credit card required.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pinned deliberately — the system prompt is tuned against this model's
# specific behavior. Swapping to a floating alias risks a silent behavior
# change the next time Google updates what that alias points to.
GEMINI_MODEL=gemini-3.6-flash

